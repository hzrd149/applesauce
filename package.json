{
  "name": "applesauce",
  "private": true,
  "scripts": {
    "dev": "cd apps/examples && pnpm dev",
    "build": "turbo build",
    "test": "turbo build --filter='./packages/*' && vitest run",
    "coverage": "turbo build --filter='./packages/*' && vitest run --coverage",
    "format": "prettier --write .",
    "npm:release-preview": "node scripts/release-preview.mjs",
    "npm:release-commit": "changeset version && pnpm jsr:sync && pnpm install --no-frozen-lockfile && git add pnpm-lock.yaml packages/*/deno.json && git commit --amend --no-edit",
    "npm:release": "pnpm run -r build && changeset publish",
    "npm:prerelease-snapshot": "pnpm build && pnpm test",
    "npm:release-snapshot": "node scripts/snapshot-release.mjs",
    "npm:release-next": "node scripts/snapshot-release.mjs --tag next",
    "npm:verify-next-release": "node scripts/snapshot-release.mjs --tag next --verify-only",
    "jsr:sync": "node scripts/jsr-manifests.mjs",
    "jsr:check": "node scripts/jsr-manifests.mjs --check",
    "jsr:test": "node --test scripts/__tests__/jsr-*.node-test.mjs",
    "jsr:smoke": "deno run --check --allow-env --allow-read=packages --sloppy-imports scripts/jsr-smoke.ts",
    "jsr:dry-run": "node scripts/jsr-release.mjs --dry-run",
    "jsr:release": "node scripts/jsr-release.mjs",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "docs": "cd apps/docs && pnpm dev"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "typedoc": "^0.28.20"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/types": "^7.0.0",
    "@hirez_io/observer-spy": "^2.2.0",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "vitest-websocket-mock": "^0.5.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "resolutions": {
    "esbuild": "^0.25.0",
    "glob": ">=11.1.0",
    "tar-fs": ">=2.1.4"
  },
  "packageManager": "pnpm@12.11.2"
}
