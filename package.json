{
  "name": "applesauce",
  "private": true,
  "scripts": {
    "dev": "cd apps/examples && pnpm dev",
    "build": "turbo build",
    "test": "turbo build --filter='./packages/*' && vitest run",
    "coverage": "turbo build --filter='./packages/*' && vitest run --coverage",
    "format": "prettier --write .",
    "release-preview": "node scripts/release-preview.mjs",
    "release-commit": "changeset version && pnpm install --no-frozen-lockfile && git add pnpm-lock.yaml && git commit --amend --no-edit",
    "release": "pnpm run -r build && changeset publish",
    "prerelease-snapshot": "pnpm build && pnpm test",
    "release-snapshot": "node scripts/snapshot-release.mjs",
    "release-next": "node scripts/snapshot-release.mjs --tag next",
    "verify-next-release": "node scripts/snapshot-release.mjs --tag next --verify-only",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "docs": "cd apps/docs && pnpm dev"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "typedoc": "^0.28.20"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/types": "^7.0.0",
    "@hirez_io/observer-spy": "^2.2.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vitest-websocket-mock": "^0.8.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "resolutions": {
    "esbuild": "^0.25.0",
    "glob": ">=11.1.0",
    "tar-fs": ">=2.1.4"
  },
  "packageManager": "pnpm@12.11.2"
}
