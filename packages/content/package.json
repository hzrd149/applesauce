{
  "name": "applesauce-content",
  "version": "7.0.0",
  "description": "Unified plugins for processing event content",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "watch:build": "tsc --watch > /dev/null",
    "test": "vitest run --config ../../vitest.config.mts --dir . --passWithNoTests",
    "watch:test": "vitest --config ../../vitest.config.mts --dir ."
  },
  "keywords": [
    "nostr"
  ],
  "author": "hzrd149",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./helpers": {
      "import": "./dist/helpers/index.js",
      "require": "./dist/helpers/index.js",
      "types": "./dist/helpers/index.d.ts"
    },
    "./helpers/*": {
      "import": "./dist/helpers/*.js",
      "require": "./dist/helpers/*.js",
      "types": "./dist/helpers/*.d.ts"
    },
    "./nast": {
      "import": "./dist/nast/index.js",
      "require": "./dist/nast/index.js",
      "types": "./dist/nast/index.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown/index.js",
      "require": "./dist/markdown/index.js",
      "types": "./dist/markdown/index.d.ts"
    },
    "./markdown/*": {
      "import": "./dist/markdown/*.js",
      "require": "./dist/markdown/*.js",
      "types": "./dist/markdown/*.d.ts"
    },
    "./text": {
      "import": "./dist/text/index.js",
      "require": "./dist/text/index.js",
      "types": "./dist/text/index.d.ts"
    },
    "./text/*": {
      "import": "./dist/text/*.js",
      "require": "./dist/text/*.js",
      "types": "./dist/text/*.d.ts"
    }
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "applesauce-common": "^7.0.0",
    "applesauce-core": "^7.0.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.0.1"
  },
  "devDependencies": {
    "@cashu/cashu-ts": "^4.11.0",
    "applesauce-signers": "^7.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@cashu/cashu-ts": "^4.11.0"
  },
  "peerDependenciesMeta": {
    "@cashu/cashu-ts": {
      "optional": true
    }
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:nostrudel@geyser.fund"
  }
}
