{
  "name": "applesauce-signers",
  "version": "7.1.0",
  "description": "Signer classes for applesauce",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "watch:build": "tsc --watch > /dev/null",
    "test": "vitest run --config ../../vitest.config.mts --dir . --passWithNoTests",
    "watch:test": "vitest --config ../../vitest.config.mts --dir ."
  },
  "keywords": [
    "nostr",
    "signer",
    "nostr-connect",
    "applesauce"
  ],
  "author": "hzrd149",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./signers": {
      "import": "./dist/signers/index.js",
      "require": "./dist/signers/index.js",
      "types": "./dist/signers/index.d.ts"
    },
    "./signers/*": {
      "import": "./dist/signers/*.js",
      "require": "./dist/signers/*.js",
      "types": "./dist/signers/*.d.ts"
    },
    "./helpers": {
      "import": "./dist/helpers/index.js",
      "require": "./dist/helpers/index.js",
      "types": "./dist/helpers/index.d.ts"
    },
    "./helpers/*": {
      "import": "./dist/helpers/*.js",
      "require": "./dist/helpers/*.js",
      "types": "./dist/helpers/*.d.ts"
    }
  },
  "dependencies": {
    "@noble/secp256k1": "^3.2.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "applesauce-core": "^7.1.0",
    "nanoid": "^6.0.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/dom-serial": "^1.0.7",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vitest-websocket-mock": "^0.8.0"
  },
  "funding": {
    "type": "lightning",
    "url": "lightning:nostrudel@geyser.fund"
  },
  "optionalDependencies": {
    "capacitor-plugin-nostr-signer": "^0.2.0"
  }
}
